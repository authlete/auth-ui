# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Authorization Server (the typescript-oauth-server we built)
AS_BASE_URL=http://localhost:3000


# Storage (libSQL)
# Local dev: a plain file. Vercel/production: a free Turso database URL
# (libsql://<db>.turso.io) plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/auth-ui.sqlite
# DATABASE_AUTH_TOKEN=   # only for a remote Turso database

# Server
PORT=3001
NODE_ENV=development

# Interaction protocol (mutual JWT)
# Stable identifiers for issuer/audience claims. Default to BETTER_AUTH_URL / AS_BASE_URL if unset.
AUTH_UI_ISSUER_ID=
AS_ISSUER_ID=
# Where to fetch the AS's published JWKS for verifying inbound JWTs.
AS_JWKS_URI=
# Channel mode: backchannel (server-to-server, production) | frontchannel (dev only)
INTERACTION_CHANNEL=backchannel
# auth-ui's full private JWKS (JSON; published with private fields stripped at /.well-known/jwks.json).
# Generate any ES256 keypair, then format as: {"keys":[<jwk-with-d>]}
AUTH_UI_JWKS=
# Optional explicit signing-key kid. If unset, the resolver picks the only key, then by alg, then first.
AUTH_UI_SIGNING_KID=
