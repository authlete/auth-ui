# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Storage (libSQL)
# Local dev: a plain file. Vercel/production: a free Turso database URL
# (libsql://<db>.turso.io) plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/auth-ui.sqlite
# DATABASE_AUTH_TOKEN=   # only for a remote Turso database

# Server
PORT=3001
NODE_ENV=development

# Interaction protocol (mutual JWT). AS_ISSUER_ID is the AS's stable identity (the
# trust anchor) and the origin its JWKS is fetched from at /.well-known/jwks.json.
# The AS's per-request callback URL rides the interaction token, not here — see
# INTERACTION_PROTOCOL.md §1.
AS_ISSUER_ID=http://localhost:3000
# auth-ui's own private signing JWKS (published, private fields stripped, at
# /.well-known/jwks.json). Generate an ES256 keypair: {"keys":[<jwk-with-d>]}
AUTH_UI_JWKS=

# Email (optional). With no RESEND_API_KEY, auth emails (verify, password
# reset) are logged to the console — local dev needs no provider. Set the key
# (Vercel Marketplace → Resend) to send for real. EMAIL_FROM needs a verified
# domain in prod; onboarding@resend.dev works for dev sends.
RESEND_API_KEY=
EMAIL_FROM="Auth UI <onboarding@resend.dev>"

# Social / OIDC sign-in (all optional). A provider's button appears only when
# BOTH its <PROVIDER>_CLIENT_ID and <PROVIDER>_CLIENT_SECRET are set — leave
# unset (local dev default) for username/password only. Set the pair in Vercel
# to enable. Redirect/callback URL to register with the provider is:
#   {BETTER_AUTH_URL}/api/auth/callback/<provider>
# Works for any better-auth built-in; the OIDC majors:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
