# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Storage (libSQL)
# Local dev: a plain file. Vercel/production: a free Turso database URL
# (libsql://<db>.turso.io) plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/auth-ui.sqlite
# DATABASE_AUTH_TOKEN=   # only for a remote Turso database

# Server
PORT=3001
NODE_ENV=development

# Interaction protocol (mutual JWT). AS_URL is the AS's base URL — its identity,
# and the origin its JWKS is fetched from at /.well-known/jwks.json. The AS's
# per-request callback base arrives in the interaction token, not here — see
# INTERACTION_PROTOCOL.md §1.
AS_URL=http://localhost:3000
# auth-ui's own private signing JWKS (published, private fields stripped, at
# /.well-known/jwks.json). Generate an ES256 keypair: {"keys":[<jwk-with-d>]}
AUTH_UI_JWKS=
