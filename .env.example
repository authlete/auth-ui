# ── Standalone auth app — `npm run setup` fills the blanks ───────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# libSQL: a local file in dev; a Turso URL (+ DATABASE_AUTH_TOKEN) when hosted.
DATABASE_URL=file:./data/auth-ui.sqlite
# DATABASE_AUTH_TOKEN=

PORT=3001
NODE_ENV=development

# ── OAuth consent UI — only when pairing with the authorization server ───────
AS_ISSUER_ID=http://localhost:3000
AUTH_UI_JWKS=

# ── Optional: email + social sign-in — see README › Configuration ────────────
# RESEND_API_KEY=
# EMAIL_FROM="Auth UI <onboarding@resend.dev>"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
