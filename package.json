    "@libsql/kysely-libsql": "^0.4.1",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.0.0",
    "better-auth": "^1.6.23",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.17.0",
    "next": "16.0.10",
    "next-themes": "^0.4.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.10.0",
